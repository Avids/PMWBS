{
  "appId": "com.pathmaster.app",
  "productName": "PathMaster",
  "copyright": "Copyright © 2026 PathMaster",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "fileAssociations": [
      {
        "ext": "wbs",
        "name": "PathMaster Project Schedule",
        "description": "PathMaster Project Schedule File",
        "role": "Editor"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "PathMaster",
    "uninstallDisplayName": "PathMaster"
  }
}
